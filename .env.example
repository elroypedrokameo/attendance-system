# MySQL Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=employee_db
MYSQL_USER=dexa_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_PORT=3307

# Database Names
EMPLOYEE_DB_NAME=employee_db
ATTENDANCE_DB_NAME=attendance_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=1d

# Attendance Schedule
WORK_START_TIME=09:15

# Service Ports
PORT_API_GATEWAY=3000
PORT_EMPLOYEE_SERVICE=3001
PORT_ATTENDANCE_SERVICE=3002

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_public_hash.r2.dev


